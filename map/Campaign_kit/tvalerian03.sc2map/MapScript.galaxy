bool gf_ABChoicevsAir () {
    // Automatic Variable Declarations
    // Implementation
    if (((UserDataGetInt("StoryStates", "TValerian03Enemy", "Value", 1) == 1) || (UserDataGetInt("StoryStates", "TValerian03Enemy", "Value", 1) == 3))) {
        return true;
    }
    else {
        return false;
    }
}

bool gf_ABChoicevsGround () {
    // Automatic Variable Declarations
    // Implementation
    if (((UserDataGetInt("StoryStates", "TValerian03Enemy", "Value", 1) == 2) || (UserDataGetInt("StoryStates", "TValerian03Enemy", "Value", 1) == 3))) {
        return true;
    }
    else {
        return false;
    }
}

string gf_ABUnit (string lp_aUnit, string lp_bUnit) {
    // Automatic Variable Declarations
    // Implementation
    if ((gf_ABChoicevsAir() == true) && (gf_ABChoicevsGround() == true)) {
        return gf_RandomUnit(lp_aUnit, lp_bUnit);
    }

    if ((gf_ABChoicevsAir() == true)) {
        return lp_aUnit;
    }
    else {
        return lp_bUnit;
    }
}

string gf_RandomUnit (string lp_aUnit, string lp_bUnit) {
    // Automatic Variable Declarations
    // Implementation
    if ((RandomInt(0, 1) == 0)) {
        return lp_aUnit;
    }
    else {
        return lp_bUnit;
    }
}

