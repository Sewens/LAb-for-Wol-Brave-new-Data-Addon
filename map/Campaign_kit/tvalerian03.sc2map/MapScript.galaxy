    // Automatic Variable Declarations
    // Variable Initialization
    lv_textLoc = UnitGetPosition(EventUnit());

    // Conditions
    if (testConds) {
        if (!(((UnitGetType(EventUnit()) == "PickupGrenades") || (UnitGetType(EventUnit()) == "PickupPlasmaGun") || (UnitGetType(EventUnit()) == "PickupChronoRiftDevice") || (UnitGetType(EventUnit()) == "PickupChronoRiftCharge")))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    UnitCreateEffectPoint(EventUnit(), "NukeDamage", UnitGetPosition(EventUnit()));
    UnitRemove(EventUnit());
    return true;
}

