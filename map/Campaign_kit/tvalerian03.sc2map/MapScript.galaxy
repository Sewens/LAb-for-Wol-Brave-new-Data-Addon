bool gt_Z1DropPods_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_repeat;

    // Automatic Variable Declarations
    int auto777C3815_val;
    int auto3B49CA00_n;
    int auto3B49CA00_i;

    // Variable Initialization

    // Actions
    if (!runActions) {
        return true;
    }

    if (((libB27CC4B1_gf_TalentAcquired("ChallengeZeratul1") == false) || (libB27CC4B1_gf_TalentAcquired("ChallengeChar3") == false))) {
        return true;
    }

    auto777C3815_val = gv_kerriganAttackCount;
    if (auto777C3815_val == 0) {
        lv_repeat = 1;
    }
    else if (auto777C3815_val == 1) {
        lv_repeat = 2;
    }
    else if (auto777C3815_val == 2) {
        lv_repeat = 2;
    }
    else {
        lv_repeat = 3;
    }
    auto3B49CA00_n = lv_repeat;
    for (auto3B49CA00_i = 1; auto3B49CA00_i <= auto3B49CA00_n; auto3B49CA00_i += 1) {
        Wait(RandomFixed(1.0, 5.0), c_timeAI);
        TriggerExecute(gt_Z1SpawnDropPod, true, false);
    }
    return true;
}

