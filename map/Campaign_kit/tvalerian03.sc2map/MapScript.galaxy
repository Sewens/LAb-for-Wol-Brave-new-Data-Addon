            // Transmission - SoundLink("TValerian03Horner00044", -1)
            libCamp_gf_SendTransmissionCampaign(null, SoundLink("TValerian03Horner00044", -1), c_transmissionDurationAdd, 0.0, true);
        }
        else if (auto22463A28_val == 2) {
