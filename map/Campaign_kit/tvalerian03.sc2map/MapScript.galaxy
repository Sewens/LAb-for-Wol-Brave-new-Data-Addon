//--------------------------------------------------------------------------------------------------
bool gt_H2ChallengeInfestation_Func (bool testConds, bool runActions) {
    // Variable Declarations
    unit lv_victim;
    unitgroup lv_marinesCombine;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_marinesCombine = UnitGroupEmpty();

    // Actions
    if (!runActions) {
        return true;
    }

    if ((RandomInt(1, 5) > 1)) {
        return true;
    }

    lv_marinesCombine = UnitGroup("Marine", gv_pLAYER_USER, RegionPlayableMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    UnitGroupAddUnitGroup(lv_marinesCombine, UnitGroup("WarPig", gv_pLAYER_USER, RegionPlayableMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0));
    lv_victim = UnitGroupRandomUnit(lv_marinesCombine, c_unitCountAlive);
    Wait(RandomFixed(7.5, 45.0), c_timeAI);
    if ((UnitFilterMatch(lv_victim, 1, UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32)))) == true)) {
        UnitKill(lv_victim);
        UnitCreate(1, "InfestedTerranCampaign", 0, gv_pLAYER_ZERG_SPECIAL, UnitGetPosition(lv_victim), libNtve_gf_RandomAngle());
        AISetUnitScriptControlled(UnitLastCreated(), false);
        AISetUnitSuicide(UnitLastCreated(), true);
    }

    return true;
}

