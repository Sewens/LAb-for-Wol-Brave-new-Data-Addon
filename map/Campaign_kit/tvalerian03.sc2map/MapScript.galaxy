    for ( ; auto77FF04E3_var <= auto77FF04E3_ae; auto77FF04E3_var += 1 ) {
        if ((UserDataGetInt("RogueTalents", UserDataInstance("RogueTalents", auto77FF04E3_var), "Rarity", 1) == -3) && (UserDataGetInt("RogueTalents", UserDataInstance("RogueTalents", auto77FF04E3_var), "Acquired", 1) >= 1)) {
