    gv_nydusWormHP = libNtve_gf_DifficultyValueFixed(200.0, 300.0, 400.0, 500.0);
    gv_leviathanMaxHP = libNtve_gf_DifficultyValueFixed(1500.0, 2000.0, 2500.0, 3000.0);
