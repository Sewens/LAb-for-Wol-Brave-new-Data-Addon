void gf_Z4CreateWave (int lp_air) {
    // Variable Declarations
    int lv_quantityTotal;
    int lv_quantityComponent;
    int lv_jackpot;
    region lv_region;

    // Automatic Variable Declarations
    // Variable Initialization

    // Implementation
    AISetGroupSuicide(UnitGroup(null, gv_pLAYER_CHALLENGE, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0), true);
    gv_z4AttackWave = UnitGroupEmpty();
    if ((lp_air >= 1)) {
        lv_quantityTotal = FixedToInt((libB27CC4B1_gf_CurseAttackWaveModifier(gv_z4WaveQ) * 0.75));
        lv_region = RegionFromId(45);
    }
    else {
        lv_quantityTotal = libB27CC4B1_gf_CurseAttackWaveModifier(gv_z4WaveQ);
        lv_region = RegionFromId(42);
    }
    do {
        if ((lp_air >= 1)) {
            if ((lv_quantityTotal >= 6)) {
                lv_quantityComponent = RandomInt(1, 6);
            }
            else {
                lv_quantityComponent = RandomInt(1, lv_quantityTotal);
            }
        }
        else {
            if ((lv_quantityTotal >= 9)) {
                lv_quantityComponent = RandomInt(1, 9);
            }
            else {
                lv_quantityComponent = RandomInt(1, lv_quantityTotal);
            }
        }
        lv_jackpot = RandomInt(1, 100);
        if ((lv_jackpot == 1)) {
            gf_Z4CreateHero(lv_region);
            lv_quantityTotal -= 3;
        }
        else {
            gf_Z4CreateWaveComponent((lv_quantityComponent - 1), lp_air, lv_region);
            lv_quantityTotal -= lv_quantityComponent;
        }
    }while ((lv_quantityTotal > 0));
    AISetGroupSuicide(gv_z4AttackWave, true);
}

