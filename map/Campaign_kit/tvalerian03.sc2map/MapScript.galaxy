    int lv_rand;

    // Automatic Variable Declarations
    // Variable Initialization

    // Implementation
    lv_newAmount = (lp_amount * libNtve_gf_DifficultyValueFixed(0.7, 1.0, 1.3, 1.6));
    lv_integerAmount = TruncI(lv_newAmount);
    if ((IntToFixed(lv_integerAmount) == lv_newAmount)) {
        return lv_integerAmount;
    }
    else {
        lv_chance = TruncI(((lv_newAmount - IntToFixed(lv_integerAmount)) * 100.0));
        lv_rand = RandomInt(1, 100);
        if ((lv_rand <= lv_chance)) {
            return (lv_integerAmount + 1);
        }
        else {
            return lv_integerAmount;
        }
    }
}

