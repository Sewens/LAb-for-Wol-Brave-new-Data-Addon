//--------------------------------------------------------------------------------------------------
// Trigger: A1 Weeping Zealots Creator
//--------------------------------------------------------------------------------------------------
bool gt_A1WeepingZealotsCreator_Func (bool testConds, bool runActions) {
    // Variable Declarations
    point lv_target;

    // Automatic Variable Declarations
    // Variable Initialization

    // Actions
    if (!runActions) {
        return true;
    }

    Wait(120.0, c_timeAI);
    TriggerEnable(gt_A1WeepingZealotsActivator, true);
    while (true) {
        Wait(RandomFixed(30.0, 60.0), c_timeAI);
        while (!((UnitGroupCount(gv_a1WeepingZealots, c_unitCountAlive) < 30))) {
            Wait(1.0, c_timeReal);
        }
        do {
            lv_target = RegionRandomPoint(RegionFromId(44));
            Wait(1.0, c_timeAI);
        }while (((DistanceBetweenPoints(CameraGetTarget(gv_pLAYER_USER), lv_target) < 25.0) || (PointPathingPassable(lv_target) == false)));
        UnitCreate(1, "StoneZealot", 0, gv_pLAYER_CHALLENGE, lv_target, libNtve_gf_RandomAngle());
        UnitGroupAdd(gv_a1WeepingZealots, UnitLastCreated());
        UnitSetTeamColorIndex(UnitLastCreated(), 0);
        libNtve_gf_PauseUnit(UnitLastCreated(), true);
        UnitSetState(UnitLastCreated(), c_unitStateTargetable, false);
        UnitSetState(UnitLastCreated(), c_unitStateSelectable, false);
        UnitSetState(UnitLastCreated(), c_unitStateInvulnerable, true);
        UnitSetState(UnitLastCreated(), c_unitStateStatusBar, false);
        UnitSetState(UnitLastCreated(), c_unitStateFidget, false);
        libNtve_gf_PlayAnimation(libNtve_gf_MainActorofUnit(UnitLastCreated()), c_animNameDefault, "Stand Work", c_animFlagPlayForever, c_animTimeDefault);
    }
    return true;
}

